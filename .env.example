# HireRoom environment variables.
# Copy this file to .env.local and fill it in yourself. Never commit .env.local.
# Never paste real keys into the agent chat.

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails that get admin access
ADMIN_EMAILS=
# Any long random string you make up. Protects the email worker route.
CRON_SECRET=

# ---- Supabase (project settings, API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase projects may call these the publishable and secret keys.

# ---- Claude API (Anthropic console, API keys) ----
ANTHROPIC_API_KEY=
# Check the Anthropic docs for the current model name and set it here.
ANTHROPIC_MODEL=

# ---- Email (Resend dashboard; verify your sending domain first) ----
RESEND_API_KEY=
# Example: HireRoom <hello@yourdomain.com>
EMAIL_FROM=
# From Supabase dashboard, Auth Hooks, Send Email hook, Generate Secret (v1,whsec_...)
SEND_EMAIL_HOOK_SECRET=

# ---- GitHub App (Phase 2, challenge repo picker) ----
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ---- Optional: OCR service for scanned resumes (Docling server) ----
DOCLING_URL=

# Google sign-in: set the client ID and secret in the Supabase dashboard
# (Authentication, Providers). They do not go in this file.
